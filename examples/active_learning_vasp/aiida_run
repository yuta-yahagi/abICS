#!/usr/bin/env python3
"""Submit VASP calculations prepared by abICS to AiiDA using aiida-vasp.

This script reads the directories listed in ``rundirs.txt`` (generated by
``abics_mlref``) and submits one ``VaspWorkChain`` for each directory.  The
workflow relies on the ``aiida-vasp`` plugin.  We assume that the work chains
should reproduce the calculations that would otherwise be started by
``parallel_run.sh`` through ``run_vasp.sh``.

The code and potential family can either be provided with command line options
or by defining the environment variables ``AIIDA_VASP_CODE`` and
``AIIDA_VASP_POTENTIAL_FAMILY``.

Example usage::

    verdi run aiida_run --code vasp@cluster --potential-family PBE.54

By default the script looks for ``rundirs.txt`` in the current working
directory.  The file should contain one calculation directory per line.
``INCAR``, ``POSCAR``, ``KPOINTS`` and (optionally) ``POTCAR`` must already be
present in each directory.
"""
from __future__ import annotations

import argparse
import logging
import os
import sys
from pathlib import Path
from typing import Callable, Dict, Iterable, List, Optional, Sequence

from aiida import orm
from aiida.engine import run_get_node, submit
from aiida.engine.processes.builder import ProcessBuilder
from aiida.manage.configuration import load_profile
from aiida.plugins import WorkflowFactory
from aiida.common import exceptions as aiida_exc

from pymatgen.io.vasp import inputs as vasp_inputs
from pymatgen.io.ase import AseAtomsAdaptor


_LOGGER = logging.getLogger(__name__)


def parse_arguments(argv: Optional[Sequence[str]] = None) -> argparse.Namespace:
    """Parse command line arguments."""
    parser = argparse.ArgumentParser(
        description="Submit VASP calculations prepared by abICS to AiiDA",
    )
    parser.add_argument(
        "--code",
        help=(
            "Label of the aiida-vasp code (e.g. `vasp@cluster`). "
            "If omitted, the value is read from the AIIDA_VASP_CODE environment variable."
        ),
    )
    parser.add_argument(
        "--potential-family",
        help=(
            "Name of the VASP potential family stored in AiiDA. "
            "If omitted, the value is read from the AIIDA_VASP_POTENTIAL_FAMILY environment variable."
        ),
    )
    parser.add_argument(
        "--potential-map",
        default=None,
        help=(
            "Comma separated mapping of chemical symbols to potential names. "
            "Example: Mg:Mg_pv,Al:Al,O:O.  If omitted, the mapping is inferred "
            "from POTCAR files found in the calculation directories."
        ),
    )
    parser.add_argument(
        "--rundirs-file",
        default="rundirs.txt",
        help="Path to the file that lists the calculation directories.",
    )
    parser.add_argument(
        "--workflow",
        default="vasp.vasp",
        help="Entry point of the aiida-vasp workflow to submit (default: vasp.vasp).",
    )
    parser.add_argument(
        "--queue-name",
        default=None,
        help="Optional name of the scheduler queue to submit to.",
    )
    parser.add_argument(
        "--account",
        default=None,
        help="Optional project / account string for the scheduler submission.",
    )
    parser.add_argument(
        "--max-wallclock",
        type=int,
        default=24 * 60 * 60,
        help="Maximum wallclock time in seconds for each calculation (default: 86400).",
    )
    parser.add_argument(
        "--num-machines",
        type=int,
        default=1,
        help="Number of machines to request for each calculation (default: 1).",
    )
    parser.add_argument(
        "--num-mpiprocs-per-machine",
        type=int,
        default=32,
        help=(
            "Number of MPI processes per machine to request for each calculation "
            "(default: 32)."
        ),
    )
    parser.add_argument(
        "--with-mpi",
        action="store_true",
        help="Explicitly enable MPI for the calculations (default: disabled).",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Perform an AiiDA dry-run instead of submitting to the daemon.",
    )
    parser.add_argument(
        "--profile",
        default=None,
        help="Explicit AiiDA profile to load.  Defaults to the configured default profile.",
    )
    parser.add_argument(
        "--clean-workdir",
        dest="clean_workdir",
        action="store_true",
        help="Remove remote work directories after successful completion.",
    )
    parser.add_argument(
        "--no-clean-workdir",
        dest="clean_workdir",
        action="store_false",
        help="Do not remove remote work directories after completion (default).",
    )
    parser.set_defaults(clean_workdir=False)

    return parser.parse_args(argv)


def load_rundirs(path: Path) -> List[Path]:
    """Return calculation directories listed in *path*."""
    if not path.exists():
        raise FileNotFoundError(f"Cannot read rundirs list: {path!s}")

    rundirs: List[Path] = []
    for line in path.read_text().splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        rundir = (path.parent / stripped).resolve()
        if not rundir.is_dir():
            raise FileNotFoundError(f"Calculation directory does not exist: {rundir!s}")
        rundirs.append(rundir)

    if not rundirs:
        raise RuntimeError(f"No calculation directories found in {path!s}")
    return rundirs


def parse_potential_map(arg: Optional[str]) -> Optional[Dict[str, str]]:
    """Parse ``SPEC:POT`` pairs into a dictionary."""
    if arg is None:
        return None
    mapping: Dict[str, str] = {}
    for item in arg.split(","):
        item = item.strip()
        if not item:
            continue
        try:
            symbol, potential = item.split(":", 1)
        except ValueError as exc:
            raise ValueError(
                "Invalid potential mapping entry: '{item}'. Expected format 'SPEC:POT'."
            ) from exc
        mapping[symbol.strip()] = potential.strip()
    return mapping


def infer_potential_map(structure: vasp_inputs.Poscar, potcar_path: Path) -> Dict[str, str]:
    """Infer potential mapping from a POTCAR file."""
    if not potcar_path.exists():
        raise FileNotFoundError(
            "Cannot infer potential mapping – POTCAR file is missing. Provide one "
            "or specify --potential-map explicitly."
        )
    potcar = vasp_inputs.Potcar.from_file(str(potcar_path))
    mapping: Dict[str, str] = {}
    species_sequence = [site.specie.symbol for site in structure.structure.sites]
    if len(potcar) != len(species_sequence):
        raise RuntimeError(
            "Number of entries in POTCAR does not match number of sites in POSCAR."
        )
    for specie, potential in zip(species_sequence, potcar):
        mapping.setdefault(specie, potential.symbol)
    return mapping


def load_structure(poscar_path: Path) -> orm.StructureData:
    """Read POSCAR and convert it to an AiiDA StructureData."""
    poscar = vasp_inputs.Poscar.from_file(str(poscar_path))
    atoms = AseAtomsAdaptor().get_atoms(poscar.structure)
    return orm.StructureData(ase=atoms)


def load_incar(incar_path: Path) -> orm.Dict:
    """Read INCAR and convert to an AiiDA Dict."""
    incar = vasp_inputs.Incar.from_file(str(incar_path))
    parameters: Dict[str, object] = {}
    for key, value in incar.as_dict().items():
        if isinstance(value, (list, tuple)):
            parameters[key] = [convert_incar_value(v) for v in value]
        else:
            parameters[key] = convert_incar_value(value)
    return orm.Dict(dict=parameters)


def convert_incar_value(value: object) -> object:
    """Convert INCAR values to JSON serialisable python objects."""
    if hasattr(value, "tolist"):
        return value.tolist()
    if isinstance(value, (int, float, str, bool)) or value is None:
        return value
    if isinstance(value, (list, tuple)):
        return [convert_incar_value(item) for item in value]
    return str(value)


def load_kpoints(kpoints_path: Path) -> orm.KpointsData:
    """Read KPOINTS file and convert it to KpointsData."""
    kp = vasp_inputs.Kpoints.from_file(str(kpoints_path))
    kpoints = orm.KpointsData()
    if kp.kpts:
        if kp.style in {"Monkhorst", "Monkhorst-Pack", "Gamma", "Gamma-centered"} and len(kp.kpts) == 1:
            mesh = tuple(int(v) for v in kp.kpts[0])
            offset = tuple(float(v) for v in kp.kpts_shift or (0.0, 0.0, 0.0))
            kpoints.set_kpoints_mesh(mesh, offset=offset)
        else:
            weights: Optional[List[float]] = None
            if kp.kweights:
                weights = [float(w) for w in kp.kweights]
            kpoints.set_kpoints([
                [float(coord) for coord in point] for point in kp.kpts
            ], weights=weights)
    else:
        # Default to Gamma point
        kpoints.set_kpoints_mesh((1, 1, 1))
    return kpoints


def build_builder(
    rundir: Path,
    code: orm.Code,
    workflow_cls,
    potential_family: str,
    potential_map: Optional[Dict[str, str]],
    resources: Dict[str, object],
    queue_name: Optional[str],
    account: Optional[str],
    max_wallclock: int,
    clean_workdir: bool,
    with_mpi: bool,
) -> ProcessBuilder:
    """Create a ProcessBuilder for a VaspWorkChain."""
    builder = workflow_cls.get_builder()
    builder.code = code

    structure_node = load_structure(rundir / "POSCAR")
    builder.structure = structure_node
    builder.parameters = load_incar(rundir / "INCAR")
    builder.kpoints = load_kpoints(rundir / "KPOINTS")

    poscar = vasp_inputs.Poscar.from_file(str(rundir / "POSCAR"))
    if potential_map is None:
        potentials = infer_potential_map(poscar, rundir / "POTCAR")
    else:
        potentials = potential_map

    missing_species = sorted({site.specie.symbol for site in poscar.structure.sites} - potentials.keys())
    if missing_species:
        raise RuntimeError(
            f"Missing potential mapping for species {', '.join(missing_species)} in {rundir!s}."
        )

    builder.potential_family = orm.Str(potential_family)
    builder.potential_mapping = orm.Dict(dict=potentials)

    builder.metadata.label = f"VASP:{rundir.name}"
    builder.metadata.description = f"VASP calculation submitted by aiida_run for {rundir!s}"

    options = builder.metadata.options
    options["resources"] = resources
    options["max_wallclock_seconds"] = max_wallclock
    options["withmpi"] = with_mpi
    if queue_name:
        options["queue_name"] = queue_name
    if account:
        options["account"] = account

    builder.clean_workdir = orm.Bool(clean_workdir)

    return builder


def submit_calculations(
    rundirs: Iterable[Path],
    builder_factory: Callable[[Path], ProcessBuilder],
    dry_run: bool,
) -> List[orm.ProcessNode]:
    """Submit or dry-run the provided builders."""
    nodes: List[orm.ProcessNode] = []
    for rundir in rundirs:
        builder = builder_factory(rundir)
        _LOGGER.info("Submitting workchain for %s", rundir)
        builder.metadata.dry_run = dry_run
        if dry_run:
            _, node = run_get_node(builder)
        else:
            node = submit(builder)
        nodes.append(node)
        _LOGGER.info(" -> PK %s (UUID %s)", node.pk, node.uuid)
    return nodes


def main(argv: Optional[Sequence[str]] = None) -> int:
    args = parse_arguments(argv)

    logging.basicConfig(level=logging.INFO, format="%(levelname)s: %(message)s")

    try:
        load_profile(args.profile)
    except aiida_exc.LoadingConfigurationError as exc:
        _LOGGER.error("Unable to load AiiDA profile: %s", exc)
        return 1
    except aiida_exc.ProfileConfigurationError as exc:
        _LOGGER.error("AiiDA profile configuration error: %s", exc)
        return 1

    code_label = args.code or os.environ.get("AIIDA_VASP_CODE")
    if not code_label:
        _LOGGER.error(
            "A VASP code label must be provided via --code or the AIIDA_VASP_CODE environment variable."
        )
        return 1

    try:
        code = orm.load_code(code_label)
    except Exception as exc:  # pylint: disable=broad-except
        _LOGGER.error("Unable to load code '%s': %s", code_label, exc)
        return 1

    rundirs_file = Path(args.rundirs_file)
    try:
        rundirs = load_rundirs(rundirs_file)
    except Exception as exc:  # pylint: disable=broad-except
        _LOGGER.error("Failed to read calculation directories: %s", exc)
        return 1

    try:
        potential_map_value = args.potential_map or os.environ.get("AIIDA_VASP_POTENTIAL_MAP")
        parsed_potential_map = parse_potential_map(potential_map_value)
    except Exception as exc:  # pylint: disable=broad-except
        _LOGGER.error("Failed to parse potential mapping: %s", exc)
        return 1

    potential_family = args.potential_family or os.environ.get("AIIDA_VASP_POTENTIAL_FAMILY")
    if not potential_family:
        _LOGGER.error(
            "A VASP potential family must be provided via --potential-family or the "
            "AIIDA_VASP_POTENTIAL_FAMILY environment variable."
        )
        return 1

    queue_name = args.queue_name or os.environ.get("AIIDA_VASP_QUEUE")
    account = args.account or os.environ.get("AIIDA_VASP_ACCOUNT")

    try:
        num_machines = int(os.environ.get("AIIDA_VASP_NUM_MACHINES", args.num_machines))
        num_mpiprocs = int(
            os.environ.get(
                "AIIDA_VASP_NUM_MPIPROCS_PER_MACHINE", args.num_mpiprocs_per_machine
            )
        )
    except ValueError as exc:
        _LOGGER.error("Invalid numeric resources specified via environment variables: %s", exc)
        return 1

    with_mpi = args.with_mpi
    with_mpi_env = os.environ.get("AIIDA_VASP_WITH_MPI")
    if with_mpi_env is not None:
        with_mpi = with_mpi_env.strip().lower() in {"1", "true", "yes", "on"}

    try:
        max_wallclock = int(os.environ.get("AIIDA_VASP_MAX_WALLCLOCK", args.max_wallclock))
    except ValueError as exc:
        _LOGGER.error("Invalid wallclock time specified via environment variables: %s", exc)
        return 1

    resources: Dict[str, object] = {
        "num_machines": num_machines,
        "num_mpiprocs_per_machine": num_mpiprocs,
    }

    def builder_factory(rundir: Path) -> orm.ProcessBuilder:
        return build_builder(
            rundir=rundir,
            code=code,
            workflow_entry=args.workflow,
            potential_family=potential_family,
            potential_map=parsed_potential_map,
            resources=resources,
            queue_name=queue_name,
            account=account,
            max_wallclock=max_wallclock,
            clean_workdir=args.clean_workdir,
            with_mpi=with_mpi,
        )

    try:
        workflow_cls = WorkflowFactory(args.workflow)
    except aiida_exc.EntryPointError as exc:
        _LOGGER.error("Unable to load workflow '%s': %s", args.workflow, exc)
        return 1

    def builder_factory(rundir: Path) -> ProcessBuilder:
        return build_builder(
            rundir=rundir,
            code=code,
            workflow_cls=workflow_cls,
            potential_family=potential_family,
            potential_map=parsed_potential_map,
            resources=resources,
            queue_name=queue_name,
            account=account,
            max_wallclock=max_wallclock,
            clean_workdir=args.clean_workdir,
            with_mpi=with_mpi,
        )

    try:
        nodes = submit_calculations(rundirs, builder_factory, dry_run=args.dry_run)
    except Exception as exc:  # pylint: disable=broad-except
        _LOGGER.error("Failed to submit calculations: %s", exc)
        return 1

    if args.dry_run:
        _LOGGER.info("Dry-run completed for %d calculations.", len(nodes))
    else:
        _LOGGER.info("Submitted %d calculations.", len(nodes))
        _LOGGER.info("You can monitor the progress with `verdi process list`." )
    return 0


if __name__ == "__main__":
    sys.exit(main())
